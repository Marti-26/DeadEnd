[sub_resource type="GDScript" id="GDScript_phwha"]
script/source = "extends Camera3D

@export var objetivo: Node3D
@export var desfase := Vector3(0, 14.141, 15.253)
@export var limite_x := 5.2
@export var limite_z := Vector2(-1.2, 1.2)
@export var suavizado := 4.0


func _process(delta: float) -> void:
	if objetivo == null:
		return
	var p := objetivo.global_position
	var meta := Vector3(clampf(p.x, -limite_x, limite_x), 0.0, clampf(p.z, limite_z.x, limite_z.y)) + desfase
	global_position = global_position.lerp(meta, 1.0 - exp(-suavizado * delta))
"

